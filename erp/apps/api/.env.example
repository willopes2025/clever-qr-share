DATABASE_URL="postgresql://soul:soul@localhost:5432/soul_erp?schema=public"
JWT_SECRET="troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_TERMINAL_TTL="24h"
PORT=3000

# Provedor fiscal: fake | focus | rest
# 'fake' autoriza tudo localmente e não fala com ninguém — é o modo de
# desenvolvimento. 'focus' é a Focus NFe, o provedor contratado.
FISCAL_PROVIDER="fake"

# 1 = produção (nota com valor fiscal), 2 = homologação (nota sem valor).
FISCAL_ENVIRONMENT=2

# Token da Focus NFe (painel > Empresas > token de homologação ou produção).
FOCUS_TOKEN=""

# Segredo do gatilho: a Focus chama /v1/webhooks/fiscal/focus?key=<este valor>.
# Sem ele configurado a rota recusa qualquer chamada.
FISCAL_WEBHOOK_SECRET=""

# Só para testes: aponta o adaptador a um dublê local. Vazio em produção.
FOCUS_BASE_URL=""

# Provedor REST genérico (adaptador de reserva, caso troque de fornecedor).
FISCAL_BASE_URL=""
FISCAL_API_KEY=""
