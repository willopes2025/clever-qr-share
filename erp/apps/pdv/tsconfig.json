{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@soul/contracts": ["../../packages/contracts/src"],
      "@soul/money": ["../../packages/money/src"],
      "@soul/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
