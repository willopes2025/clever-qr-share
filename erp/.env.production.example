# Copie para .env ao lado do docker-compose.prod.yml e preencha.

DOMAIN=soulmuscle.wideic.com

# Banco
POSTGRES_USER=soul
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=soul_erp

# Assinatura dos tokens — gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_TERMINAL_TTL=24h

# Fuso do quiosque. Decide onde começa e termina o dia no painel e na curva
# por hora. Quiosque em outro estado, outro fuso.
BUSINESS_TIMEZONE=America/Sao_Paulo

# Fiscal — Focus NFe.
# 'fake' autoriza notas simuladas e não fala com a SEFAZ; use enquanto o
# certificado não está no ar. Com o provedor contratado, troque para 'focus'.
FISCAL_PROVIDER=focus

# 1 = produção (nota vale), 2 = homologação (nota de teste, sem valor fiscal).
# Comece em 2, valide um cupom ponta a ponta, só então vá para 1.
FISCAL_ENVIRONMENT=2

# Token da empresa no painel da Focus. Homologação e produção têm tokens
# diferentes: trocar de ambiente é trocar os dois valores juntos.
FOCUS_TOKEN=

# Segredo do gatilho (webhook). Gere com: openssl rand -hex 24
# Registre na Focus a URL: https://${DOMAIN}/v1/webhooks/fiscal/focus?key=<este valor>
FISCAL_WEBHOOK_SECRET=

# Provedor REST genérico — só se um dia trocar de fornecedor.
FISCAL_BASE_URL=
FISCAL_API_KEY=
