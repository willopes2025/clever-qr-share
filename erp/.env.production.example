# Copie para .env ao lado do docker-compose.prod.yml e preencha.

DOMAIN=soulmuscle.wideic.com

# Banco
POSTGRES_USER=soul
POSTGRES_PASSWORD=troque-por-uma-senha-longa
POSTGRES_DB=soul_erp

# Assinatura dos tokens — gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_TERMINAL_TTL=24h

# Fiscal: 'fake' emite notas simuladas (homologação interna).
# Ao contratar o provedor, troque para o adaptador real e preencha as chaves.
FISCAL_PROVIDER=fake
FISCAL_ENVIRONMENT=2
FISCAL_BASE_URL=
FISCAL_API_KEY=
